	(text "MCU DE METROLOGIA — STM32F413RHT6\n\nEscolhido por ser da mesma família da plataforma de referência da biblioteca\nADSW-PQ-CLS (IEC 61000-4-30 Classe S) da ADI: NUCLEO-F413ZH.\n\nSPI1 (PA4-PA7) -> ADE9430 via isolador (folha 06); SS_SID (PB0) -> MCP3204\nIRQ0/IRQ1/DREADY/ZX (PC4-PC7): EXTI; ZX em TIM3_CH2 (captura de período)\nCF1/CF2 (PA0/PA1): TIM2_ETR/TIM5_CH2 (contagem de pulsos de energia)\nUSART2 (PA2/PA3) -> placa HMI (folha 07); USART3 (PC10/PC11) + DE (PC12) -> RS-485\nUSB FS (PA11/PA12) -> USB-C de serviço (folha 08); PA9 = detecção de VBUS\nPC0 = VBAT_SENSE (ADC); PC1/PC2 = ~CHG/~PGOOD do carregador\nRTC interno com LSE 32,768 kHz e CR2032 (BT501) para manter data/hora."
		(exclude_from_sim no)(at 180.34 175.26 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "7dd51e01-d3eb-57d6-b5f4-380a05506c1f")
	)
